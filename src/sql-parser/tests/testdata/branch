parse-statement
CREATE BRANCH b FROM CLUSTER prod IN CLUSTER bc
----
CREATE BRANCH b FROM CLUSTER prod IN CLUSTER bc
=>
CreateBranch(CreateBranchStatement { name: Ident("b"), cluster_maps: [BranchClusterMap { prod_cluster: Ident("prod"), branch_cluster: Ident("bc") }], options: [] })

parse-statement
CREATE BRANCH b FROM CLUSTER prod IN CLUSTER bc WITH (EXPIRES IN = '48h')
----
CREATE BRANCH b FROM CLUSTER prod IN CLUSTER bc WITH (EXPIRES IN = '48h')
=>
CreateBranch(CreateBranchStatement { name: Ident("b"), cluster_maps: [BranchClusterMap { prod_cluster: Ident("prod"), branch_cluster: Ident("bc") }], options: [CreateBranchOption { name: ExpiresIn, value: Some(Value(String("48h"))) }] })

parse-statement
CREATE BRANCH b FROM CLUSTER prod IN CLUSTER bc WITH (EXPIRES IN '48h')
----
CREATE BRANCH b FROM CLUSTER prod IN CLUSTER bc WITH (EXPIRES IN = '48h')
=>
CreateBranch(CreateBranchStatement { name: Ident("b"), cluster_maps: [BranchClusterMap { prod_cluster: Ident("prod"), branch_cluster: Ident("bc") }], options: [CreateBranchOption { name: ExpiresIn, value: Some(Value(String("48h"))) }] })

parse-statement
CREATE BRANCH b FROM CLUSTER c1 IN CLUSTER bc1, FROM CLUSTER c2 IN CLUSTER bc2
----
CREATE BRANCH b FROM CLUSTER c1 IN CLUSTER bc1, FROM CLUSTER c2 IN CLUSTER bc2
=>
CreateBranch(CreateBranchStatement { name: Ident("b"), cluster_maps: [BranchClusterMap { prod_cluster: Ident("c1"), branch_cluster: Ident("bc1") }, BranchClusterMap { prod_cluster: Ident("c2"), branch_cluster: Ident("bc2") }], options: [] })

