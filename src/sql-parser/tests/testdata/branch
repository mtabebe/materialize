parse-statement
DROP BRANCH b
----
DROP BRANCH b
=>
DropBranch(DropBranchStatement { name: Ident("b"), if_exists: false })

parse-statement
DROP BRANCH IF EXISTS b
----
DROP BRANCH IF EXISTS b
=>
DropBranch(DropBranchStatement { name: Ident("b"), if_exists: true })

parse-statement
SHOW BRANCHES
----
SHOW BRANCHES
=>
Show(ShowBranches(ShowBranchesStatement { filter: None }))

parse-statement
SHOW BRANCHES LIKE 'foo%'
----
SHOW BRANCHES LIKE 'foo%'
=>
Show(ShowBranches(ShowBranchesStatement { filter: Some(Like("foo%")) }))

parse-statement
SHOW BRANCH CHANGES b
----
SHOW BRANCH CHANGES b
=>
Show(ShowBranchChanges(ShowBranchChangesStatement { name: Ident("b"), as_sql: false }))

parse-statement
SHOW BRANCH CHANGES b AS SQL
----
SHOW BRANCH CHANGES b AS SQL
=>
Show(ShowBranchChanges(ShowBranchChangesStatement { name: Ident("b"), as_sql: true }))

parse-statement
EXPLAIN CREATE BRANCH FROM CLUSTER prod IN CLUSTER bc
----
EXPLAIN CREATE BRANCH FROM CLUSTER prod IN CLUSTER bc
=>
ExplainCreateBranch(ExplainCreateBranchStatement { cluster_maps: [BranchClusterMap { prod_cluster: Ident("prod"), branch_cluster: Ident("bc") }] })

parse-statement
SET branch = b
----
SET branch = b
=>
SetVariable(SetVariableStatement { local: false, variable: Ident("branch"), to: Values([Ident(Ident("b"))]) })

parse-statement
RESET branch
----
RESET branch
=>
ResetVariable(ResetVariableStatement { variable: Ident("branch") })
