#
# Semantic operators: `ENRICH WITH`, `AI JOIN`, and the two `ai_*` families.

mode cockroach

reset-server

# ------------------------------------------------------------------------------
# The feature flag gates the whole surface.
# ------------------------------------------------------------------------------

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_semantic_operators = false
----
COMPLETE 0

statement error ENRICH WITH, AI JOIN, and the ai_\* function family is not available
CREATE TABLE gated (body text) ENRICH WITH (severity = ai_classify(body, ARRAY['a']))

statement error ENRICH WITH, AI JOIN, and the ai_\* function family is not available
SELECT ai_similar('abc', 'abd')

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_semantic_operators = true
----
COMPLETE 0

# ------------------------------------------------------------------------------
# Layer 1: declarations, not functions. They are registered so that `ENRICH WITH`
# type-checks, and rejected everywhere else because no execution path exists.
# ------------------------------------------------------------------------------

statement error is only valid inside ENRICH WITH; it is an enrichment specification, not a callable function
SELECT ai_classify('a body', ARRAY['sev1'])

statement error is only valid inside ENRICH WITH; it is an enrichment specification, not a callable function
SELECT ai_extract('a body', 'the customer')

statement error is only valid inside ENRICH WITH; it is an enrichment specification, not a callable function
SELECT ai_score('a body', 'how urgent')

statement error is only valid inside ENRICH WITH; it is an enrichment specification, not a callable function
SELECT ai_generate('a body', 'summarize')

statement error is only valid inside ENRICH WITH; it is an enrichment specification, not a callable function
SELECT ai_embed('a body')

# ------------------------------------------------------------------------------
# Layer 2: ordinary deterministic scalar functions. No network, legal anywhere.
# ------------------------------------------------------------------------------

query R
SELECT cosine_similarity(ARRAY[1.0, 0.0]::float4[], ARRAY[1.0, 0.0]::float4[])
----
1

query R
SELECT cosine_similarity(ARRAY[1.0, 0.0]::float4[], ARRAY[0.0, 1.0]::float4[])
----
0

query R
SELECT cosine_similarity(ARRAY[1.0, 0.0]::float4[], ARRAY[-1.0, 0.0]::float4[])
----
-1

# A zero vector has no direction, so it has no angle to anything. Total rather
# than a division by zero, which would fail a whole dataflow on one bad row.
query R
SELECT cosine_similarity(ARRAY[0.0, 0.0]::float4[], ARRAY[1.0, 0.0]::float4[])
----
0

query error dimension mismatch
SELECT cosine_similarity(ARRAY[1.0]::float4[], ARRAY[1.0, 0.0]::float4[])

query R
SELECT ai_similar('materialize', 'materialize')
----
1

query B
SELECT ai_similar('Acme Corp', 'acme corp.') > ai_similar('Acme Corp', 'Globex')
----
true

query R
SELECT ai_similar('', '')
----
1

# The exact-key blocking key: two extractions of one company name agree once
# punctuation and case are gone.
query T
SELECT ai_normalize_key('Acme Corp.')
----
acmecorp

query B
SELECT ai_normalize_key('Acme Corp') = ai_normalize_key('  acme corp. ')
----
true

# The blocking key is stable, in range, and agrees with itself across calls.
query B
SELECT lsh_bucket(ARRAY[1.0, 2.0, 3.0]::float4[], 16)
     = lsh_bucket(ARRAY[1.0, 2.0, 3.0]::float4[], 16)
----
true

query B
SELECT lsh_bucket(ARRAY[1.0, 2.0, 3.0]::float4[], 8)::int BETWEEN 0 AND 7
----
true

query error buckets must be positive
SELECT lsh_bucket(ARRAY[1.0]::float4[], 0)

# `ai_similar` over embeddings is cosine similarity under another name, so the
# `AI JOIN` predicate reads the same for both key shapes.
query B
SELECT ai_similar(ARRAY[1.0, 2.0]::float4[], ARRAY[2.0, 4.0]::float4[])
     = cosine_similarity(ARRAY[1.0, 2.0]::float4[], ARRAY[2.0, 4.0]::float4[])
----
true

# ------------------------------------------------------------------------------
# `ENRICH WITH`: the expansion.
# ------------------------------------------------------------------------------

statement ok
CREATE TABLE tickets (body text, status text)
  ENRICH WITH (
    severity     = ai_classify(body, ARRAY['sev1', 'sev2', 'sev3']),
    account_name = ai_extract(body, 'canonical customer company name')
  )

# The name the user typed is a view over the relation and the store.
query TTTT
SHOW COLUMNS FROM tickets
----
body          true  text  (empty)
status        true  text  (empty)
severity      true  text  (empty)
account_name  true  text  (empty)

query TT
SELECT name, type FROM mz_objects WHERE name LIKE 'tickets%' AND id LIKE 'u%' ORDER BY name
----
tickets                view
tickets_ai_spec        view
tickets_ai_store       view
tickets_ai_store_raw   table
tickets_pending        view
tickets_raw            table

# The spec view is what lets a worker be written without reading the SQL.
query TTTTTT
SELECT column_name, kind, input_column, prompt, labels, prompt_version IS NOT NULL FROM tickets_ai_spec ORDER BY column_name
----
account_name  extract   body  canonical␠customer␠company␠name  NULL       true
severity      classify  body  NULL                            {sev1,sev2,sev3}  true

# Every enrichment shares one version, since one store answers them all at once.
query I
SELECT count(DISTINCT prompt_version) FROM tickets_ai_spec
----
1

# A row is visible with NULL labels from the moment it lands, and it is pending.
statement ok
INSERT INTO tickets_raw VALUES ('the cluster is down', 'open')

query TTTT
SELECT body, status, severity, account_name FROM tickets
----
the␠cluster␠is␠down  open  NULL  NULL

query T
SELECT input FROM tickets_pending
----
the␠cluster␠is␠down

# The worker's write. Once the answer lands the labels fill in and the input
# leaves the queue.
statement ok
INSERT INTO tickets_ai_store_raw
SELECT 'the cluster is down', prompt_version, '{"severity": "sev1", "account_name": "Acme"}'::jsonb, now()
FROM tickets_ai_spec LIMIT 1

query TTTT
SELECT body, status, severity, account_name FROM tickets
----
the␠cluster␠is␠down  open  sev1  Acme

query I
SELECT count(*) FROM tickets_pending
----
0

# A retried write leaves two rows in the append-only store. The dedup view
# absorbs it, and `tickets_pending` anti-joins against that view rather than the
# raw table so the input does not look unanswered again.
statement ok
INSERT INTO tickets_ai_store_raw
SELECT 'the cluster is down', prompt_version, '{"severity": "sev1", "account_name": "Acme"}'::jsonb, now()
FROM tickets_ai_spec LIMIT 1

query I
SELECT count(*) FROM tickets_ai_store_raw
----
2

query I
SELECT count(*) FROM tickets_ai_store
----
1

query I
SELECT count(*) FROM tickets_pending
----
0

# Five hundred rows with one body are one unit of work, because the queue is
# keyed on the input rather than on the row.
statement ok
INSERT INTO tickets_raw SELECT 'everything is slow', 'open' FROM generate_series(1, 500)

query I
SELECT count(*) FROM tickets_pending
----
1

# Churn on an unenriched column produces no new work.
statement ok
UPDATE tickets_raw SET status = 'closed' WHERE status = 'open'

query I
SELECT count(*) FROM tickets_pending
----
1

# Deleting and re-inserting a row does not re-queue it: the answer is keyed on the
# body, not on the row's existence. This is the property the whole design is for.
statement ok
DELETE FROM tickets_raw WHERE body = 'the cluster is down'

query I
SELECT count(*) FROM tickets_pending
----
1

statement ok
INSERT INTO tickets_raw VALUES ('the cluster is down', 'open')

query I
SELECT count(*) FROM tickets_pending
----
1

query TT
SELECT severity, account_name FROM tickets WHERE body = 'the cluster is down'
----
sev1  Acme

# The clause never reaches the underlying relation's stored SQL, so nothing has to
# re-plan an `ENRICH WITH` at boot.
query TT
SHOW CREATE TABLE tickets_raw
----
materialize.public.tickets_raw  CREATE␠TABLE␠materialize.public.tickets_raw␠(body␠pg_catalog.text,␠status␠pg_catalog.text);

# ------------------------------------------------------------------------------
# `ENRICH WITH` on a source, which is the surface the design is actually about. A
# webhook source is used because it needs no broker; the expansion does not care
# which kind of relation it is wrapping.
# ------------------------------------------------------------------------------

statement ok
CREATE SOURCE events FROM WEBHOOK BODY FORMAT TEXT
  ENRICH WITH (topic = ai_classify(body, ARRAY['billing', 'outage', 'howto']))

query TT
SELECT name, type FROM mz_objects WHERE name LIKE 'events%' AND id LIKE 'u%' ORDER BY name
----
events                view
events_ai_spec        view
events_ai_store       view
events_ai_store_raw   table
events_pending        view
events_raw            source

query TTTT
SHOW COLUMNS FROM events
----
body   false  text  (empty)
topic  true   text  (empty)

query TTT
SELECT column_name, kind, input_column FROM events_ai_spec
----
topic  classify  body

# ------------------------------------------------------------------------------
# `ENRICH WITH`: the errors are the user-facing surface, so they say something.
# ------------------------------------------------------------------------------

statement error ai_classify requires at least one label
CREATE TABLE bad (body text) ENRICH WITH (severity = ai_classify(body, ARRAY[]))

# A cast around the label list is not a label list: the planner reads the literal,
# it does not evaluate the expression.
statement error ai_classify requires an array of string labels
CREATE TABLE bad (body text) ENRICH WITH (severity = ai_classify(body, ARRAY[]::text[]))

statement error ENRICH WITH expects severity to be a call to an ai_\* function
CREATE TABLE bad (body text) ENRICH WITH (severity = body || 'x')

statement error lower is not an enrichment; ENRICH WITH accepts ai_classify, ai_extract, ai_score, ai_generate, ai_embed
CREATE TABLE bad (body text) ENRICH WITH (severity = lower(body))

statement error ai_classify requires an array of string labels
CREATE TABLE bad (body text) ENRICH WITH (severity = ai_classify(body, 'sev1'))

statement error the second argument to ai_extract must be a string literal prompt
CREATE TABLE bad (body text, hint text) ENRICH WITH (account = ai_extract(body, hint))

statement error the first argument to ai_classify must be a column of the relation
CREATE TABLE bad (body text) ENRICH WITH (severity = ai_classify('literal', ARRAY['a']))

statement error ENRICH WITH declares severity more than once
CREATE TABLE bad (body text)
  ENRICH WITH (severity = ai_extract(body, 'x'), severity = ai_extract(body, 'y'))

statement error enrichments must all read the same column
CREATE TABLE bad (body text, title text)
  ENRICH WITH (a = ai_extract(body, 'x'), b = ai_extract(title, 'y'))

# ------------------------------------------------------------------------------
# `AI JOIN`.
# ------------------------------------------------------------------------------

statement ok
CREATE TABLE articles (title text, emb float4[])

statement ok
CREATE TABLE docs (title text, emb float4[])

statement ok
INSERT INTO articles VALUES ('Acme Corp', ARRAY[1.0, 0.0]::float4[]), ('Globex', ARRAY[0.0, 1.0]::float4[])

statement ok
INSERT INTO docs VALUES ('acme corp.', ARRAY[1.0, 0.1]::float4[]), ('Initech', ARRAY[-1.0, 0.0]::float4[])

# The exact-key form, which gets the demo end to end before any vector work.
query TT
SELECT a.title, d.title
FROM articles a AI JOIN docs d ON ai_similar(a.title, d.title) > 0.4
ORDER BY a.title, d.title
----
Acme␠Corp  acme␠corp.

# `SCORE AS` costs nothing, since the similarity is computed anyway.
query TTB
SELECT a.title, d.title, score > 0.4
FROM articles a AI JOIN docs d ON ai_similar(a.title, d.title) > 0.4 WITH (SCORE AS score)
ORDER BY a.title
----
Acme␠Corp  acme␠corp.  true

# The threshold may come from the options instead, which is the same predicate.
query TT
SELECT a.title, d.title
FROM articles a AI JOIN docs d ON ai_similar(a.emb, d.emb) WITH (THRESHOLD = 0.9, BUCKETS = 2)
ORDER BY a.title, d.title
----
Acme␠Corp  acme␠corp.

# `TOP` bounds output. It is the one option that changes the result set, which is
# why it defaults on: a pure threshold join is unbounded and IVM materializes all
# of it.
query I
SELECT count(*)
FROM articles a AI JOIN docs d ON ai_similar(a.emb, d.emb) WITH (THRESHOLD = -1.0, TOP = 1, BUCKETS = 1)
----
2

# `> THRESHOLD` is strict, so the pair at exactly -1.0 is not emitted.
query I
SELECT count(*)
FROM articles a AI JOIN docs d ON ai_similar(a.emb, d.emb) WITH (THRESHOLD = -1.0, TOP = 0, BUCKETS = 1)
----
3

statement error AI JOIN needs a threshold
SELECT * FROM articles a AI JOIN docs d ON ai_similar(a.title, d.title)

statement error AI JOIN ON clause must be
SELECT * FROM articles a AI JOIN docs d ON a.title = d.title

statement error AI JOIN threshold is given both in the ON clause and in WITH
SELECT * FROM articles a AI JOIN docs d ON ai_similar(a.title, d.title) > 0.4 WITH (THRESHOLD = 0.9)

statement error BUCKETS must be positive
SELECT * FROM articles a AI JOIN docs d ON ai_similar(a.emb, d.emb) > 0.4 WITH (BUCKETS = 0)

statement error both sides of ai_similar must have the same type
SELECT * FROM articles a AI JOIN docs d ON ai_similar(a.title, d.emb) > 0.4

# `AI JOIN` survives into a stored view, which is why the feature flag has to be
# `enable_for_item_parsing`: the catalog re-plans this SQL at boot even if the flag
# has since been turned off.
statement ok
CREATE VIEW similar_docs AS
SELECT a.title AS article, d.title AS doc
FROM articles a AI JOIN docs d ON ai_similar(a.emb, d.emb) > 0.9 WITH (TOP = 3, BUCKETS = 4)

query TT
SHOW CREATE VIEW similar_docs
----
materialize.public.similar_docs  CREATE␠VIEW⏎␠␠␠␠materialize.public.similar_docs⏎␠␠␠␠AS⏎␠␠␠␠␠␠␠␠SELECT␠a.title␠AS␠article,␠d.title␠AS␠doc⏎␠␠␠␠␠␠␠␠FROM⏎␠␠␠␠␠␠␠␠␠␠␠␠materialize.public.articles␠AS␠a⏎␠␠␠␠␠␠␠␠␠␠␠␠␠␠␠␠␠AI␠JOIN␠materialize.public.docs␠AS␠d␠ON␠mz_catalog.ai_similar(a.emb,␠d.emb)␠>␠0.9␠WITH␠(TOP␠=␠3,␠BUCKETS␠=␠4);

query TT
SELECT article, doc FROM similar_docs ORDER BY article
----
Acme␠Corp  acme␠corp.

# The sugar changes the plan, not the meaning: strip `AI` and the options and the
# same join is there, without the blocking equi-join that makes it affordable.
query T multiline
EXPLAIN OPTIMIZED PLAN AS VERBOSE TEXT FOR
SELECT a.title, d.title
FROM articles a AI JOIN docs d ON ai_similar(a.emb, d.emb) > 0.9 WITH (BUCKETS = 4, TOP = 0)
----
Explained Query:
  Project (#0, #2)
    Filter (cosine_similarity(#1{emb}, #3{emb}) > 0.9)
      Join on=(lsh_bucket(#1{emb}, 4) = lsh_bucket(#3{emb}, 4)) type=differential
        ArrangeBy keys=[[lsh_bucket(#1{emb}, 4)]]
          Filter (#1{emb}) IS NOT NULL
            ReadStorage materialize.public.articles
        ArrangeBy keys=[[lsh_bucket(#1{emb}, 4)]]
          Filter (#1{emb}) IS NOT NULL
            ReadStorage materialize.public.docs

Source materialize.public.articles
  filter=((#1{emb}) IS NOT NULL)
Source materialize.public.docs
  filter=((#1{emb}) IS NOT NULL)

Target cluster: quickstart

EOF
