mode cockroach

reset-server

replace \d{4}-\d{2}-\d{2} [0-9:.]+\+00  <EXPIRES>

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_branching = on
----
COMPLETE 0

statement ok
CREATE TABLE t (a int)

statement ok
INSERT INTO t VALUES (1), (2)

statement ok
CREATE INDEX t_idx ON t (a)

statement ok
CREATE CLUSTER bc SIZE 'scale=1,workers=1'

statement ok
CREATE BRANCH b FROM CLUSTER quickstart IN CLUSTER bc

query I
SELECT sum(a) FROM t
----
3

statement ok
SET branch = b

# Inside the branch, `t` resolves to the branch's fork, which carries
# production's rows as of the branch point.
query I
SELECT sum(a) FROM t
----
3

statement ok
INSERT INTO t VALUES (10)

query I
SELECT sum(a) FROM t
----
13

statement ok
RESET branch

# Production did not see the branch's write.
query I
SELECT sum(a) FROM t
----
3

statement ok
INSERT INTO t VALUES (100)

query I
SELECT sum(a) FROM t
----
103

statement ok
SET branch = b

# ... and the branch did not see production's.
query I
SELECT sum(a) FROM t
----
13

statement ok
RESET branch

# An unchanged branch has nothing to report.
query TTT
SHOW BRANCH CHANGES b
----

statement ok
SET branch = b

# Create an index inside the branch, and it shows up as added.
statement ok
CREATE INDEX t_branch_idx ON t (a)

# A branch never ingests or emits on production's behalf: it reads sources
# live, and its own sink must write somewhere production does not.
statement error cannot CREATE SOURCE from within a branch
CREATE SOURCE s FROM LOAD GENERATOR COUNTER

statement error cannot ALTER SINK from within a branch
ALTER SINK nonexistent SET (COMMIT INTERVAL = '1s')

statement ok
RESET branch

query TTT
SHOW BRANCH CHANGES b
----
materialize.public.t_branch_idx  index  added

# Two spellings: the branch's own DDL, which names the branch's cluster (u2) and
# the branch's table (u3), and the same change retargeted at production (u1, u1)
# so it can be applied there.
simple
SHOW BRANCH CHANGES b AS SQL
----
CREATE INDEX "t_branch_idx" IN CLUSTER [u2] ON [u3 AS "materialize"."public"."t"] ("a"),CREATE INDEX "t_branch_idx" IN CLUSTER [u1] ON [u1 AS "materialize"."public"."t"] ("a")
COMPLETE 1

# A branch of a cluster with no indexes has nothing to rebuild, so it is ready
# the moment it exists -- unlike one whose indexes are still warming.
statement ok
CREATE CLUSTER empty_prod SIZE 'scale=1,workers=1'

statement ok
CREATE CLUSTER empty_branch SIZE 'scale=1,workers=1'

statement ok
CREATE BRANCH nothing FROM CLUSTER empty_prod IN CLUSTER empty_branch

# `b`'s index has had time to rebuild by now, and `nothing` had none to
# rebuild, so both read ready.
query TTTT
SHOW BRANCHES
----
b  u1->u2  <EXPIRES>  ready
nothing  u3->u4  <EXPIRES>  ready

statement ok
DROP BRANCH nothing

# Production is never blocked by a branch, so dropping an object a branch
# substitutes for succeeds and takes the substitute with it. The branch survives
# as an invalid record: it describes something that no longer exists, but its
# fork and retain reference are still reclaimable by dropping it.
statement ok
CREATE TABLE doomed (a int)

statement ok
CREATE CLUSTER doomed_prod SIZE 'scale=1,workers=1'

statement ok
CREATE INDEX doomed_idx IN CLUSTER doomed_prod ON doomed (a)

statement ok
CREATE CLUSTER doomed_branch SIZE 'scale=1,workers=1'

statement ok
CREATE BRANCH dangling FROM CLUSTER doomed_prod IN CLUSTER doomed_branch

statement ok
DROP TABLE doomed CASCADE

query TTTT
SHOW BRANCHES
----
b  u1->u2  <EXPIRES>  ready
dangling  u5->u6  <EXPIRES>  invalid

statement error branch dangling is invalid
SET branch = dangling

statement ok
DROP BRANCH dangling

statement ok
DROP BRANCH b

query I
SELECT sum(a) FROM t
----
103
