# Plan-time surface of cluster branches: the feature flag, the RBAC gate, and
# the branch session variable.

mode cockroach

reset-server

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_branching = off
----
COMPLETE 0

statement error CREATE BRANCH and the branch session variable is not available
CREATE BRANCH b FROM CLUSTER quickstart IN CLUSTER c

statement error CREATE BRANCH and the branch session variable is not available
DROP BRANCH b

statement error CREATE BRANCH and the branch session variable is not available
SHOW BRANCHES

statement error CREATE BRANCH and the branch session variable is not available
SET branch = b

# `RESET` restores production, so it is allowed with the feature off.
statement ok
RESET branch

simple conn=mz_system,user=mz_system
ALTER SYSTEM SET enable_branching = on
----
COMPLETE 0

query T
SHOW branch
----
(empty)

# Entering a branch is namespace policy, not a scalar setting, so the branch
# has to exist.
statement error unknown branch 'nope'
SET branch = nope

statement ok
CREATE CLUSTER bc SIZE 'scale=1,workers=1'

# The privilege is a system privilege, so a fresh role is denied.
statement ok
CREATE ROLE branchless

simple conn=mz_system,user=mz_system
GRANT CREATECLUSTER ON SYSTEM TO branchless
----
COMPLETE 0

simple conn=branchless,user=branchless
CREATE BRANCH b FROM CLUSTER quickstart IN CLUSTER bc
----
db error: ERROR: permission denied for SYSTEM
DETAIL: The 'branchless' role needs CREATEBRANCH privileges on SYSTEM

simple conn=mz_system,user=mz_system
GRANT CREATEBRANCH ON SYSTEM TO branchless
----
COMPLETE 0

simple conn=branchless,user=branchless
CREATE BRANCH b FROM CLUSTER quickstart IN CLUSTER bc
----
COMPLETE 0

# Plan-time validation runs before that.
statement error cluster quickstart cannot be both the source and the target of a branch
CREATE BRANCH b FROM CLUSTER quickstart IN CLUSTER quickstart

statement error unknown cluster 'nope'
CREATE BRANCH b FROM CLUSTER nope IN CLUSTER bc

# `quickstart` is not empty: an index binds to it.
statement ok
CREATE TABLE t (a int)

statement ok
CREATE INDEX t_idx ON t (a)

statement error cluster quickstart is not empty
CREATE BRANCH b FROM CLUSTER bc IN CLUSTER quickstart

# An expiry is wall-clock, so normalize it. `replace` applies to `query`
# records, which is why the listings below use one.
replace \d{4}-\d{2}-\d{2} [0-9:.]+\+00  <EXPIRES>

# `SHOW BRANCHES` is owner-scoped: `materialize` does not see `branchless`'s
# branch, and cannot drop it by name.
query TTT
SHOW BRANCHES
----

statement error unknown branch 'b'
DROP BRANCH b

statement ok
DROP BRANCH IF EXISTS b

# `materialize` is a superuser here, so grant itself nothing and just create
# its own branch to see the listing.
statement ok
CREATE CLUSTER bc2 SIZE 'scale=1,workers=1'

statement ok
CREATE BRANCH mine FROM CLUSTER quickstart IN CLUSTER bc2

query TTT
SHOW BRANCHES
----
mine  u1->u3  <EXPIRES>

# `EXPIRES IN` overrides the 24h default; the branch still lists.
statement ok
DROP BRANCH mine

statement ok
CREATE BRANCH mine FROM CLUSTER quickstart IN CLUSTER bc2 WITH (EXPIRES IN '1h')

query TTT
SHOW BRANCHES
----
mine  u1->u3  <EXPIRES>

statement ok
DROP BRANCH mine

# A branch spanning several clusters takes one branch point for all of them.
statement ok
CREATE CLUSTER bc3 SIZE 'scale=1,workers=1'

statement ok
CREATE CLUSTER bc4 SIZE 'scale=1,workers=1'

statement ok
CREATE BRANCH multi FROM CLUSTER quickstart IN CLUSTER bc3, FROM CLUSTER bc2 IN CLUSTER bc4

query TTT
SHOW BRANCHES
----
multi  u1->u4,u3->u5  <EXPIRES>

statement error cluster bc3 is the target of more than one map
CREATE BRANCH multi2 FROM CLUSTER quickstart IN CLUSTER bc3, FROM CLUSTER bc2 IN CLUSTER bc3

statement ok
DROP BRANCH multi

# Entering a branch, then refusing to nest.
simple conn=branchless,user=branchless
SET branch = b
----
COMPLETE 0

simple conn=branchless,user=branchless
SHOW branch
----
b
COMPLETE 1

simple conn=branchless,user=branchless
SET branch = b
----
db error: ERROR: cannot enter a branch from within a branch; RESET branch first

simple conn=branchless,user=branchless
CREATE BRANCH b2 FROM CLUSTER quickstart IN CLUSTER bc
----
db error: ERROR: cannot create a branch from within a branch; RESET branch first

simple conn=branchless,user=branchless
RESET branch
----
COMPLETE 0

# The per-owner quota bounds how many branches one role can hold.
simple conn=mz_system,user=mz_system
ALTER SYSTEM SET branch_per_owner_quota = 1
----
COMPLETE 0

simple conn=branchless,user=branchless
CREATE BRANCH b2 FROM CLUSTER quickstart IN CLUSTER bc
----
db error: ERROR: branch quota of 1 reached; drop a branch first

# A superuser drops a branch it does not own.
simple conn=mz_system,user=mz_system
DROP BRANCH b
----
COMPLETE 0

simple conn=branchless,user=branchless
SHOW BRANCHES
----
COMPLETE 0

statement error SHOW BRANCHES with a filter not yet supported
SHOW BRANCHES LIKE 'b%'

statement error SHOW BRANCH CHANGES not yet supported
SHOW BRANCH CHANGES b

statement error EXPLAIN CREATE BRANCH not yet supported
EXPLAIN CREATE BRANCH FROM CLUSTER quickstart IN CLUSTER bc
